  "beat_graph": [
    {
      "audio_sha256": "05b5602520821fd995b2d147dd4258c31cc1128d39ab570b3f9035ef46b37f62",
      "beat_id": "b01",
      "captions": [
        {
          "duration_ns": 1920000000,
          "raster_logical_path": "data/v3_port/raster/caption-7ab53c39ee2376e393180708edfd158861ac0cec080d56293f93d7827a129787.png",
          "raster_sha256": "873fe2fc340f4a438c8b746334ad99294c177d0f3f87b9db4364aa5f1c50a05e",
          "start_ns": 0,
          "text": "Почему не допилить 2D?"
        },
        {
          "duration_ns": 6100000000,
          "raster_logical_path": "data/v3_port/raster/caption-100a3c4bbc3af8728f677fa99b4ab0e28e9283bcb1ff82ed6c959a25dd079bb8.png",
          "raster_sha256": "1e5afeca942f7b73cdcd0b681522da02f4c2a928be801bb1e900f405a859dae5",
          "start_ns": 1920000000,
          "text": "Потому что даже поворот трамвая или руки, которые хватают людей, требуют новых спрайтов и анимаций."
        },
        {
          "duration_ns": 3300000000,
          "raster_logical_path": "data/v3_port/raster/caption-ec887ef8c7c7fd499ba04fcf9e3d883380205413f04dcdececae2bdc198b5d01.png",
          "raster_sha256": "ef15f3e17484eba04fc3d316cadde9ad61cf871579997e91258f7ba767b977a0",
          "start_ns": 8020000000,
          "text": "Я хочу, чтобы апгрейды заметно меняли сам трамвай."
        },
        {
          "duration_ns": 2760000000,
          "raster_logical_path": "data/v3_port/raster/caption-ffe1f32f719dea5fe47f0538cec8c01a4f10d8c229cc8cd8ff1d70080d68e2ab.png",
          "raster_sha256": "6ae0b3ad5ae49e931bd8760641a03ccbd74f7313695eb715979584cbb58a040d",
          "start_ns": 11320000000,
          "text": "В 3D для этого гораздо больше свободы."
        },
        {
          "duration_ns": 2240000000,
          "raster_logical_path": "data/v3_port/raster/caption-fea6a0f78699222d7735f87bb82ef1668a248281ea0d28124d16768b5f28e70a.png",
          "raster_sha256": "356ae0ffe389637a63c14e68b0849da47ae02e0497abb338a21ac117452d0802",
          "start_ns": 14080000000,
          "text": "Поэтому это не порт, а новая игра."
        }
      ],
      "duration_ns": 17520000000,
