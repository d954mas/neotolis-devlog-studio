{
  "schema_version": 1,
  "toolchain": {
    "python": "3.12",
    "node_major": 22
  },
  "v3_modules": [
    "foundation",
    "authoring",
    "timeline",
    "rendering",
    "assets",
    "capture",
    "speech",
    "review",
    "constraints",
    "workflow",
    "release",
    "application",
    "persistence",
    "adapters"
  ],
  "public_module": "api",
  "allowed_dependencies": {
    "foundation": [],
    "assets": ["foundation"],
    "constraints": ["foundation"],
    "timeline": ["foundation", "assets", "constraints"],
    "authoring": ["foundation", "timeline", "assets", "constraints"],
    "rendering": ["foundation", "timeline", "assets", "constraints"],
    "capture": ["foundation", "assets"],
    "speech": ["foundation", "assets"],
    "review": ["foundation", "assets", "timeline", "constraints"],
    "workflow": ["foundation", "assets", "timeline", "review", "constraints", "release"],
    "release": ["foundation", "assets", "timeline", "review", "constraints"],
    "application": ["foundation", "authoring", "timeline", "rendering", "assets", "capture", "speech", "review", "constraints", "workflow", "release"],
    "persistence": ["foundation", "assets", "capture", "speech", "review", "constraints", "workflow", "release"],
    "adapters": ["application", "persistence"]
  },
  "always_forbidden_import_prefixes": [
    "tools.studio_v3_migrate",
    "tools.studio_v3_verify"
  ],
  "always_forbidden_calls": [
    "os.chdir",
    "Path.cwd"
  ],
  "always_forbidden_symbols": [
    "GLOBAL_CHUNK_RESOLVER"
  ],
  "always_forbidden_literals": [
    {
      "name": "asset_policy",
      "value": "compatibility"
    }
  ],
  "cutover_absent_paths": [
    "common/devlog",
    "dl",
    "dl.bat",
    "common/dlstudio/src/dlstudio/api",
    "common/dlstudio/src/dlstudio/cache",
    "common/dlstudio/src/dlstudio/check",
    "common/dlstudio/src/dlstudio/cli",
    "common/dlstudio/src/dlstudio/compile",
    "common/dlstudio/src/dlstudio/model",
    "common/dlstudio/src/dlstudio/render",
    "common/dlstudio/src/dlstudio/services",
    "common/dlstudio/src/dlstudio/template",
    "common/dlstudio/src/dlstudio/ir.py",
    "common/dlstudio/src/dlstudio/production.py"
  ],
  "runtime_package_allowlist": [
    "__init__.py",
    "__main__.py",
    "adapters",
    "application",
    "assets",
    "authoring",
    "capture",
    "constraints",
    "foundation",
    "persistence",
    "release",
    "rendering",
    "review",
    "speech",
    "timeline",
    "workflow"
  ],
  "cutover_forbidden_regex": [
    "asset_policy\\s*=\\s*[\"']compatibility[\"']",
    "\\bautopilot_run\\.json\\b",
    "\\bGLOBAL_CHUNK_RESOLVER\\b",
    "\\bfrom\\s+tools\\.studio_v3_migrate\\b",
    "\\bimport\\s+tools\\.studio_v3_migrate\\b"
  ],
  "performance_hooks": [
    {
      "id": "status_no_compile_scan_subprocess",
      "owner": "workflow/application",
      "test_selector": "performance_smoke and status_no_compile_scan_subprocess"
    },
    {
      "id": "cache_hit_no_ffmpeg_full_read",
      "owner": "rendering",
      "test_selector": "performance_smoke and cache_hit_no_ffmpeg_full_read"
    },
    {
      "id": "cli_api_no_heavy_provider_import",
      "owner": "adapters",
      "test_selector": "performance_smoke and cli_api_no_heavy_provider_import"
    },
    {
      "id": "review_pack_bounded",
      "owner": "review",
      "test_selector": "performance_smoke and review_pack_bounded"
    }
  ],
  "reference_performance": {
    "report_path": "docs/studio_v3/phase7/performance_report.json",
    "budgets": {
      "cli_help": {
        "cold_ms_max": 800.0,
        "p95_ms_max": 800.0
      },
      "status_query": {
        "p95_ms_max": 100.0
      },
      "compile_check": {
        "p95_seconds_max": 0.5
      },
      "orchestration_memory": {
        "peak_bytes_max": 8388608
      }
    }
  }
}
