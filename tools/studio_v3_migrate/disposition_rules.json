{
  "schema_version": 1,
  "workspace_excludes": [
    ".agents",
    ".claude",
    ".codex",
    ".codex-remote-attachments",
    ".git",
    ".github",
    ".npm-cache-devlogs",
    ".playwright-cli",
    ".pytest_cache",
    ".runtime",
    ".test-tmp",
    "__pycache__",
    "common",
    "data",
    "docs",
    "tmp",
    "tools"
  ],
  "workspace_exclude_prefixes": [
    ".phase4-review-repro-",
    ".review-phase",
    ".test-tmp",
    "_codex_tmp_"
  ],
  "project_rules": [
    {
      "id": "active_product",
      "priority": 500,
      "marker": "product.toml",
      "disposition": "MIGRATE_ACTIVE"
    },
    {
      "id": "active_v2_project",
      "priority": 450,
      "marker": "edits",
      "marker_kind": "directory",
      "disposition": "MIGRATE_ACTIVE"
    },
    {
      "id": "known_active_override",
      "priority": 1000,
      "names": [
        "neotolis_diary",
        "not_a_trolley_problem",
        "trolley_devlog"
      ],
      "disposition": "MIGRATE_ACTIVE"
    },
    {
      "id": "known_source_archive",
      "priority": 1000,
      "names": [
        "trolley",
        "trolley3d"
      ],
      "disposition": "ARCHIVE_READ_ONLY"
    },
    {
      "id": "unknown_project_preserve",
      "priority": 0,
      "fallback": true,
      "disposition": "ARCHIVE_READ_ONLY"
    }
  ],
  "artifact_rules": [
    {
      "id": "generated_finalize_cache",
      "priority": 1200,
      "path_regex": "(^|/)(finalize|cache|__pycache__|\\.pytest_cache)(/|$)|(^|/)\\.cache(/|$)",
      "action": "RECOMPUTE",
      "target_owner": "rendering/cache"
    },
    {
      "id": "hyperframes_sources",
      "priority": 1150,
      "path_regex": "(^|/)(hyperframes)(/|$)|(^|/)data/infographics/[^/]+\\.(html|json|js|ts|css)$",
      "action": "MIGRATE",
      "target_owner": "adapters/hyperframes",
      "parse_as": "by_extension"
    },
    {
      "id": "edit_python_explicit_port",
      "priority": 1100,
      "path_regex": "(^|/)edits/.*\\.py$",
      "action": "PORT_EXPLICIT",
      "target_owner": "authoring",
      "parse_as": "python"
    },
    {
      "id": "recordings_words_speech",
      "priority": 1050,
      "path_regex": "(^|/)data/(recordings|audio)(/|$)|(^|/)([^/]*_words\\.json|speech_edit\\.json)$",
      "action": "MIGRATE",
      "target_owner": "speech/assets",
      "parse_as": "by_extension"
    },
    {
      "id": "review_evidence",
      "priority": 1000,
      "path_regex": "(^|/)data/review(/|$)|(^|/)feedback\\.json$",
      "action": "ARCHIVE",
      "target_owner": "review/archive",
      "parse_as": "by_extension"
    },
    {
      "id": "publish_license_delivery",
      "priority": 1000,
      "path_regex": "(^|/)(data/)?(publish|delivery)(/|$)|(^|/)(license|licenses|attribution)(/|[._-])",
      "action": "ARCHIVE",
      "target_owner": "release/archive",
      "parse_as": "by_extension"
    },
    {
      "id": "registry_catalog_capture",
      "priority": 950,
      "path_regex": "(^|/)data/(assets|capture|captures)(/|$)|(^|/)(asset_registry|catalog|capture_manifest|capture_request|capture_result)\\.(json|toml)$",
      "action": "MIGRATE",
      "target_owner": "assets/capture",
      "parse_as": "by_extension"
    },
    {
      "id": "story_shot_script",
      "priority": 900,
      "path_regex": "(^|/)data/(plan|story|scripts?)(/|$)|(^|/)(story_map|shot_manifest|script_manifest|production_manifest)\\.(json|toml)$",
      "action": "MIGRATE",
      "target_owner": "constraints/workflow",
      "parse_as": "by_extension"
    },
    {
      "id": "project_production_toml",
      "priority": 900,
      "path_regex": "(^|/)(devlog|product|production|preferences)\\.toml$",
      "action": "MIGRATE",
      "target_owner": "constraints/application",
      "parse_as": "toml"
    },
    {
      "id": "source_media",
      "priority": 850,
      "path_regex": "(^|/)data/(footage|images|music|sfx|fonts|infographics)(/|$)|\\.(mp4|mov|mkv|avi|webm|wav|mp3|flac|aac|ogg|m4a|png|jpg|jpeg|webp|gif|ttf|otf|woff2?)$",
      "action": "MIGRATE",
      "target_owner": "assets"
    },
    {
      "id": "local_scripts_docs",
      "priority": 700,
      "path_regex": "(^|/)(scripts?|docs?)(/|$)|\\.(md|rst|txt|ps1|bat|sh)$",
      "action": "ARCHIVE",
      "target_owner": "archive/local_context",
      "parse_as": "by_extension"
    },
    {
      "id": "generic_json_record",
      "priority": 200,
      "path_regex": "\\.json$",
      "action": "ARCHIVE",
      "target_owner": "archive/untranslated_record",
      "parse_as": "json"
    },
    {
      "id": "generic_toml_record",
      "priority": 200,
      "path_regex": "\\.toml$",
      "action": "ARCHIVE",
      "target_owner": "archive/untranslated_record",
      "parse_as": "toml"
    },
    {
      "id": "generic_python_source",
      "priority": 200,
      "path_regex": "\\.py$",
      "action": "ARCHIVE",
      "target_owner": "archive/local_source",
      "parse_as": "python"
    },
    {
      "id": "unknown_artifact_preserve",
      "priority": 0,
      "fallback": true,
      "action": "ARCHIVE",
      "target_owner": "archive/unknown_preserved"
    }
  ]
}
