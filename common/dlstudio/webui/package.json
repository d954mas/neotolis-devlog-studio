{
  "name": "dlstudio-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test \"test/*.test.mjs\"",
    "test:e2e": "npm run typecheck:e2e && playwright test --config playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "openapi:schema": "python ../../../tools/studio_v3_openapi.py --output src/api/openapi.v3.json",
    "openapi:types": "openapi-typescript src/api/openapi.v3.json -o src/api/v3.gen.ts",
    "generate:client": "npm run openapi:schema && npm run openapi:types",
    "preview": "vite preview"
  },
  "dependencies": {
    "openapi-fetch": "0.15.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "22.14.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "js-yaml": "4.3.0",
    "minimatch": "10.2.5"
  }
}
