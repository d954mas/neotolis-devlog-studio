              "$ref": "#/components/schemas/ReviewTimelineItem"
            },
            "title": "Items",
            "type": "array"
          },
          "latest_round": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BlobRef"
              },
              {
                "type": "null"
              }
