{
  "components": {
    "schemas": {
      "BlobRef": {
        "description": "Exact identity of immutable bytes in an object store.",
        "properties": {
          "sha256": {
            "title": "Sha256",
            "type": "string"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "sha256",
          "size"
        ],
        "title": "BlobRef",
        "type": "object"
      },
      "DeliveryBody": {
        "additionalProperties": false,
        "properties": {
          "destination_id": {
            "title": "Destination Id",
            "type": "string"
          }
        },
        "required": [
          "destination_id"
        ],
        "title": "DeliveryBody",
        "type": "object"
      },
      "DeliveryReceipt": {
        "properties": {
          "candidate_id": {
            "title": "Candidate Id",
            "type": "string"
          },
          "delivered_at": {
            "title": "Delivered At",
            "type": "string"
          },
          "destination_id": {
            "title": "Destination Id",
            "type": "string"
          },
          "manifest": {
            "items": {
              "$ref": "#/components/schemas/PackageFile"
            },
            "title": "Manifest",
            "type": "array"
          }
        },
        "required": [
          "candidate_id",
          "destination_id",
          "delivered_at",
          "manifest"
        ],
        "title": "DeliveryReceipt",
        "type": "object"
      },
      "DeliveryResponse": {
        "additionalProperties": false,
        "properties": {
          "receipt": {
            "$ref": "#/components/schemas/DeliveryReceipt"
          },
          "status": {
            "$ref": "#/components/schemas/WorkflowStatus"
          }
        },
        "required": [
          "status",
          "receipt"
        ],
        "title": "DeliveryResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "NamedRef": {
        "properties": {
          "blob": {
            "$ref": "#/components/schemas/BlobRef"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "blob"
        ],
        "title": "NamedRef",
        "type": "object"
      },
      "PackageFile": {
        "properties": {
          "blob": {
            "$ref": "#/components/schemas/BlobRef"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "blob"
        ],
        "title": "PackageFile",
        "type": "object"
      },
      "ReviewFindingBody": {
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "title": "Finding Id",
            "type": "string"
          },
          "requires_change": {
            "default": false,
            "title": "Requires Change",
            "type": "boolean"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "text"
        ],
        "title": "ReviewFindingBody",
        "type": "object"
      },
      "ReviewVerdictBody": {
        "additionalProperties": false,
        "properties": {
          "findings": {
            "items": {
              "$ref": "#/components/schemas/ReviewFindingBody"
            },
            "title": "Findings",
            "type": "array"
          },
          "outcome": {
            "enum": [
              "pass",
              "changes_requested",
              "block"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "reviewed_at": {
            "title": "Reviewed At",
            "type": "string"
          },
          "reviewer": {
            "title": "Reviewer",
            "type": "string"
          },
          "scope": {
            "items": {
              "type": "string"
            },
            "title": "Scope",
            "type": "array"
          }
        },
        "required": [
          "outcome",
          "scope",
          "reviewer",
          "reviewed_at",
          "findings"
        ],
        "title": "ReviewVerdictBody",
        "type": "object"
      },
      "StageAttempt": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/NamedRef"
            },
            "title": "Inputs",
            "type": "array"
          },
          "operation_id": {
            "title": "Operation Id",
            "type": "string"
          },
          "outputs": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/NamedRef"
            },
            "title": "Outputs",
            "type": "array"
          },
          "stage": {
            "enum": [
              "prepare",
              "draft",
              "final",
              "review",
              "package",
              "deliver"
            ],
            "title": "Stage",
            "type": "string"
          },
          "state": {
            "default": "running",
            "enum": [
              "running",
              "succeeded",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "stage",
          "operation_id",
          "inputs"
        ],
        "title": "StageAttempt",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkflowRun": {
        "properties": {
          "attempts": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/StageAttempt"
            },
            "title": "Attempts",
            "type": "array"
          },
          "delivery_receipt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BlobRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "eligible_candidate": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BlobRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "reel",
              "longform",
              "capture_vo"
            ],
            "title": "Kind",
            "type": "string"
          },
          "production_id": {
            "title": "Production Id",
            "type": "string"
          },
          "revision": {
            "default": 0,
            "title": "Revision",
            "type": "integer"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "production_id",
          "kind"
        ],
        "title": "WorkflowRun",
        "type": "object"
      },
      "WorkflowStatus": {
        "description": "Read-only application projection shared by every adapter.",
        "properties": {
          "action": {
            "anyOf": [
              {
                "enum": [
                  "advance",
                  "review",
                  "deliver"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "completed": {
            "title": "Completed",
            "type": "boolean"
          },
          "current_stage": {
            "anyOf": [
              {
                "enum": [
                  "prepare",
                  "draft",
                  "final",
                  "review",
                  "package",
                  "deliver"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Stage"
          },
          "production_id": {
            "title": "Production Id",
            "type": "string"
          },
          "stage_order": {
            "items": {
              "enum": [
                "prepare",
                "draft",
                "final",
                "review",
                "package",
                "deliver"
              ],
              "type": "string"
            },
            "title": "Stage Order",
            "type": "array"
          },
          "workflow": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkflowRun"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "production_id",
          "workflow",
          "stage_order",
          "current_stage",
          "completed",
          "action"
        ],
        "title": "WorkflowStatus",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "DLStudio v3",
    "version": "3.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v3/advance": {
      "post": {
        "operationId": "advanceProduction",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Advance Route"
      }
    },
    "/api/v3/blobs/{sha256}": {
      "get": {
        "operationId": "getBlob",
        "parameters": [
          {
            "in": "path",
            "name": "sha256",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": true,
            "schema": {
              "exclusiveMinimum": 0,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Blob"
      }
    },
    "/api/v3/deliver": {
      "post": {
        "operationId": "deliverProduction",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeliveryBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Deliver"
      }
    },
    "/api/v3/review": {
      "post": {
        "operationId": "submitReview",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewVerdictBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Review"
      }
    },
    "/api/v3/status": {
      "get": {
        "operationId": "getStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Status"
      }
    }
  }
}
