          },
          "latest_verdict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReviewVerdict"
              },
              {
                "type": "null"
              }
            ]
          },
          "timeline": {
            "$ref": "#/components/schemas/BlobRef"
          },
          "width": {
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "artifact",
          "timeline",
          "check_report",
          "constraints",
          "latest_round",
          "latest_verdict",
          "width",
          "height",
          "fps_num",
          "fps_den",
