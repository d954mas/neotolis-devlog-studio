{
  "components": {
    "schemas": {
      "BlobRef": {
        "description": "Exact identity of immutable bytes in an object store.",
        "properties": {
          "sha256": {
            "title": "Sha256",
            "type": "string"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "sha256",
          "size"
        ],
        "title": "BlobRef",
        "type": "object"
      },
      "DeliveryBody": {
        "additionalProperties": false,
        "properties": {
          "destination_id": {
            "title": "Destination Id",
            "type": "string"
          }
        },
        "required": [
          "destination_id"
        ],
        "title": "DeliveryBody",
        "type": "object"
      },
      "DeliveryReceipt": {
        "properties": {
          "candidate_id": {
            "title": "Candidate Id",
            "type": "string"
          },
          "delivered_at": {
            "title": "Delivered At",
            "type": "string"
          },
          "destination_id": {
            "title": "Destination Id",
            "type": "string"
          },
          "manifest": {
            "items": {
              "$ref": "#/components/schemas/PackageFile"
            },
            "title": "Manifest",
            "type": "array"
          }
        },
        "required": [
          "candidate_id",
          "destination_id",
          "delivered_at",
          "manifest"
        ],
        "title": "DeliveryReceipt",
        "type": "object"
      },
      "DeliveryResponse": {
        "additionalProperties": false,
        "properties": {
          "receipt": {
            "$ref": "#/components/schemas/DeliveryReceipt"
          },
          "status": {
            "$ref": "#/components/schemas/WorkflowStatus"
          }
        },
        "required": [
          "status",
          "receipt"
        ],
        "title": "DeliveryResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "NamedRef": {
        "properties": {
          "blob": {
            "$ref": "#/components/schemas/BlobRef"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "blob"
        ],
        "title": "NamedRef",
        "type": "object"
      },
      "PackageFile": {
        "properties": {
          "blob": {
            "$ref": "#/components/schemas/BlobRef"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "blob"
        ],
        "title": "PackageFile",
        "type": "object"
      },
      "ReviewContext": {
        "properties": {
          "artifact": {
            "$ref": "#/components/schemas/BlobRef"
          },
          "check_report": {
            "$ref": "#/components/schemas/BlobRef"
          },
