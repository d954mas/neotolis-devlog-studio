              "type": "string"
            },
            "title": "Target Ids",
            "type": "array"
          }
        },
        "required": [
          "start_frame",
          "end_frame_exclusive"
        ],
        "title": "ReviewLocator",
        "type": "object"
      },
      "ReviewLocatorBody": {
        "additionalProperties": false,
        "properties": {
          "end_frame_exclusive": {
            "title": "End Frame Exclusive",
            "type": "integer"
          },
          "region": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReviewRegionBody"
              },
              {
                "type": "null"
              }
            ]
          },
          "start_frame": {
            "title": "Start Frame",
            "type": "integer"
          },
          "target_ids": {
            "items": {
              "type": "string"
            },
            "title": "Target Ids",
            "type": "array"
          }
        },
        "required": [
          "start_frame",
          "end_frame_exclusive"
        ],
        "title": "ReviewLocatorBody",
        "type": "object"
      },
      "ReviewRegion": {
        "description": "Normalized 0..1000 rectangle inside the reviewed frame.",
        "properties": {
          "height_milli": {
            "title": "Height Milli",
            "type": "integer"
          },
          "width_milli": {
            "title": "Width Milli",
            "type": "integer"
          },
          "x_milli": {
            "title": "X Milli",
            "type": "integer"
          },
          "y_milli": {
            "title": "Y Milli",
            "type": "integer"
          }
        },
        "required": [
          "x_milli",
          "y_milli",
          "width_milli",
          "height_milli"
        ],
        "title": "ReviewRegion",
        "type": "object"
      },
      "ReviewRegionBody": {
        "additionalProperties": false,
        "properties": {
          "height_milli": {
            "title": "Height Milli",
            "type": "integer"
          },
          "width_milli": {
            "title": "Width Milli",
            "type": "integer"
          },
          "x_milli": {
            "title": "X Milli",
            "type": "integer"
          },
          "y_milli": {
            "title": "Y Milli",
            "type": "integer"
          }
        },
        "required": [
          "x_milli",
          "y_milli",
          "width_milli",
          "height_milli"
        ],
        "title": "ReviewRegionBody",
        "type": "object"
      },
      "ReviewResolutionBody": {
        "additionalProperties": false,
        "properties": {
          "current_finding_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Finding Id"
          },
          "previous_finding_id": {
            "title": "Previous Finding Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "fixed",
              "obsolete",
              "still_wrong"
            ],
            "title": "Status",
