            ]
          }
        },
        "required": [
          "production_id",
          "workflow",
          "stage_order",
          "current_stage",
          "completed",
          "action"
        ],
        "title": "WorkflowStatus",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "DLStudio v3",
    "version": "3.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v3/advance": {
      "post": {
        "operationId": "advanceProduction",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Advance Route"
      }
    },
    "/api/v3/blobs/{sha256}": {
      "get": {
        "operationId": "getBlob",
        "parameters": [
          {
            "in": "path",
            "name": "sha256",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": true,
            "schema": {
              "exclusiveMinimum": 0,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Blob"
      }
    },
    "/api/v3/deliver": {
      "post": {
        "operationId": "deliverProduction",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeliveryBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Deliver"
      }
    },
    "/api/v3/review": {
      "post": {
        "operationId": "submitReview",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewVerdictBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Review"
      }
    },
    "/api/v3/review/artifacts/{sha256}": {
      "get": {
        "operationId": "getReviewArtifact",
        "parameters": [
          {
            "in": "path",
            "name": "sha256",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": true,
            "schema": {
              "exclusiveMinimum": 0,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "video/mp4": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Review Artifact"
      }
    },
    "/api/v3/review/context": {
      "get": {
        "operationId": "getReviewContext",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewContext"
                }
