          },
          "item_id": {
            "title": "Item Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "visual",
              "audio",
              "transition"
            ],
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "lane": {
            "title": "Lane",
            "type": "string"
          },
          "start_ns": {
            "title": "Start Ns",
            "type": "integer"
          },
          "z": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Z"
          }
        },
        "required": [
          "item_id",
          "kind",
          "lane",
          "label",
          "start_ns",
          "duration_ns"
        ],
        "title": "ReviewTimelineItem",
        "type": "object"
      },
      "ReviewVerdict": {
        "properties": {
          "artifact": {
            "$ref": "#/components/schemas/BlobRef"
          },
          "check_report": {
            "$ref": "#/components/schemas/BlobRef"
          },
          "constraints": {
            "$ref": "#/components/schemas/BlobRef"
          },
          "evidence": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/BlobRef"
            },
            "title": "Evidence",
            "type": "array"
          },
          "findings": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ReviewFinding"
            },
            "title": "Findings",
            "type": "array"
          },
          "outcome": {
            "enum": [
              "pass",
              "changes_requested",
              "block"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "review_pack": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BlobRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewed_at": {
            "title": "Reviewed At",
            "type": "string"
          },
          "reviewer": {
            "title": "Reviewer",
            "type": "string"
          },
          "scope": {
            "items": {
              "type": "string"
            },
            "title": "Scope",
            "type": "array"
          }
        },
        "required": [
          "artifact",
          "outcome",
          "check_report",
          "constraints",
          "scope",
          "reviewer",
          "reviewed_at"
        ],
        "title": "ReviewVerdict",
        "type": "object"
      },
      "ReviewVerdictBody": {
        "additionalProperties": false,
        "properties": {
          "expected_artifact": {
            "$ref": "#/components/schemas/BlobRef"
          },
          "expected_check_report": {
            "$ref": "#/components/schemas/BlobRef"
          },
          "expected_constraints": {
            "$ref": "#/components/schemas/BlobRef"
          },
          "expected_latest_round": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BlobRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "expected_timeline": {
            "$ref": "#/components/schemas/BlobRef"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/ReviewFindingBody"
            },
            "title": "Findings",
            "type": "array"
          },
          "outcome": {
            "enum": [
              "pass",
              "changes_requested",
              "block"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "resolutions": {
            "items": {
              "$ref": "#/components/schemas/ReviewResolutionBody"
            },
            "title": "Resolutions",
            "type": "array"
          },
          "reviewed_at": {
            "title": "Reviewed At",
            "type": "string"
          },
          "reviewer": {
            "title": "Reviewer",
            "type": "string"
          },
          "scope": {
            "items": {
              "type": "string"
            },
            "title": "Scope",
            "type": "array"
          }
        },
        "required": [
          "expected_artifact",
          "expected_timeline",
          "expected_check_report",
          "expected_constraints",
          "outcome",
          "scope",
          "reviewer",
          "reviewed_at",
          "findings"
        ],
        "title": "ReviewVerdictBody",
        "type": "object"
      },
      "StageAttempt": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/NamedRef"
            },
            "title": "Inputs",
            "type": "array"
          },
          "operation_id": {
            "title": "Operation Id",
            "type": "string"
          },
          "outputs": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/NamedRef"
            },
            "title": "Outputs",
            "type": "array"
          },
          "stage": {
            "enum": [
              "prepare",
              "draft",
              "final",
              "review",
              "package",
              "deliver"
            ],
            "title": "Stage",
            "type": "string"
          },
          "state": {
            "default": "running",
            "enum": [
              "running",
              "succeeded",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "stage",
          "operation_id",
          "inputs"
        ],
        "title": "StageAttempt",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkflowRun": {
        "properties": {
          "attempts": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/StageAttempt"
            },
            "title": "Attempts",
            "type": "array"
          },
          "delivery_receipt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BlobRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "eligible_candidate": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BlobRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "reel",
              "longform",
              "capture_vo"
            ],
            "title": "Kind",
            "type": "string"
          },
          "production_id": {
            "title": "Production Id",
            "type": "string"
          },
          "revision": {
            "default": 0,
            "title": "Revision",
            "type": "integer"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "production_id",
          "kind"
        ],
        "title": "WorkflowRun",
        "type": "object"
      },
      "WorkflowStatus": {
        "description": "Read-only application projection shared by every adapter.",
        "properties": {
          "action": {
            "anyOf": [
              {
                "enum": [
                  "advance",
                  "review",
                  "deliver"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "completed": {
            "title": "Completed",
            "type": "boolean"
          },
          "current_stage": {
            "anyOf": [
              {
                "enum": [
                  "prepare",
                  "draft",
                  "final",
                  "review",
                  "package",
                  "deliver"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Stage"
          },
          "production_id": {
            "title": "Production Id",
            "type": "string"
          },
          "stage_order": {
            "items": {
              "enum": [
                "prepare",
                "draft",
                "final",
                "review",
                "package",
                "deliver"
              ],
              "type": "string"
            },
            "title": "Stage Order",
            "type": "array"
          },
          "workflow": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkflowRun"
              },
              {
                "type": "null"
